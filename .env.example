# **************************** #
# ******   BASIC SETUP  ****** #
# **************************** #
# APC40 <-> Cakewalk port names (edit these, then re-run:
#   uv run apc40sonar --list-ports
# Windows/loopMIDI renames cables between iterations, so match what the
# listing shows. No reboot or code change is required.
#
# APC40_PORT        physical controller        (read + write)
# MCU_OUT_PORT      app -> Cakewalk surface    (write)
# MCU_IN_PORT       Cakewalk surface -> app    (read)
# APC40_CLIENT_NAME name this app shows to WinMM

APC40_PORT=Akai APC40
MCU_OUT_PORT=APC40-IN
MCU_IN_PORT=APC40-OUT
APC40_CLIENT_NAME=apc40sonar
# APC40 operating mode: generic | ableton | alt-ableton
APC40_MODE=generic


# ************************************ #
# ******   FEATURE FINE TUNING  ****** #
# ************************************ #
# Max V-pot steps per Track/Device knob event; lower = finer control (default 3)
KNOB_STEP_LIMIT=3
# Ignore knob steps larger than this as noise/ring re-reference (default 4; 0 = off)
KNOB_NOISE_THRESHOLD=4
# Track level meters on the clip grid, clip latch on Clip Stop: on | off (default on)
METERS=on
# Meter fall time per grid segment in milliseconds (default 300, like a real MCU)
METER_DECAY_MS=300
# Crossfader zoom: slider travel (0-127 scale) per zoom step; lower = faster (default 6)
ZOOM_STEP_UNITS=6
# Leave Cakewalk's zoom mode this long after the crossfader stops, in ms (default 300)
ZOOM_IDLE_MS=300
# Playhead step sizes: <count> <unit>, unit = measure | beat | tick (1/960 beat) | jog
# (jog = the Mackie preset's Jog Wheel Resolution). Measure/beat steps snap to the grid.
CUE_STEP=1 beat
SHIFT_CUE_STEP=30 tick
NUDGE_STEP=1 measure
# Repeat interval while Nudge is held (after a 0.4 s hold), in ms
NUDGE_REPEAT_MS=150
# A tapped (one-shot) Shift expires after this long, in ms (default 3000)
SHIFT_ONESHOT_MS=3000


# ****************************** #
# ******  STEP SEQUENCER  ****** #
# ****************************** #
# Optional (Scene 2). Two more loopMIDI cables; see the setup guide.
# SEQ_OUT_PORT      sequencer notes, app -> Cakewalk (a drum track's input)
# CLOCK_IN_PORT     Cakewalk's MIDI clock -> app (Preferences > Project > MIDI)
SEQ_OUT_PORT=APC40-SEQ
CLOCK_IN_PORT=APC40-CLOCK
# One MIDI note per lane (grid rows; Bank Up/Down pages them 5 at a time).
# Default: GM kick, snare, closed hat, open hat, clap, rim, low/mid/high tom, crash
SEQ_NOTES=36 38 42 46 39 37 45 47 50 49
# MIDI channel 1-16 for every lane (10 = General MIDI drums)
SEQ_CHANNEL=10
# Pattern length in 1/16 steps, 1-64 (Bank Left/Right pages them 8 at a time)
SEQ_STEPS=16
# Velocities for green (normal), amber (accent) and red (soft) steps
SEQ_VELOCITIES=100 127 60
# Editor window while in Scene 2: on | off (default on)
SEQ_EDITOR=on
# UDP port to the editor window; its edits come back on this + 1 (default 47041)
SEQ_EDITOR_PORT=47041
# Folder for the autosaved pattern (current.json) and .mid exports, relative to this file
SEQ_DIR=patterns
# Draw the playhead (Clip Stop row, editor) this far ahead of the clock, 0-500 ms, so it
# lines up with what you hear. Tune it live in the editor ("Playhead lead"), which then
# overrides this value (default 40)
SEQ_DISPLAY_LEAD_MS=40
# SEQ_NOTES / SEQ_CHANNEL / SEQ_STEPS only shape a brand-new pattern; after that the
# saved pattern (edited in the window or on the APC40) is used.


# ****************************** #
# ******   ON-SCREEN HUD  ****** #
# ****************************** #
# Small always-on-top window: knob mode, transport, track names, toasts (default on)
HUD=on
# UDP port on 127.0.0.1 between the app and the HUD window (default 47040)
HUD_PORT=47040
# top-left | top-right | bottom-left | bottom-right | x,y  (default top-right)
HUD_POSITION=top-right
# Monitor index for placement, 0 = primary (default 0)
HUD_MONITOR=0
# Window opacity 0.2-1.0 (default 0.85)
HUD_OPACITY=0.85
# Keep the HUD above other windows: on | off (default on)
HUD_TOPMOST=on
# Mouse clicks pass through the HUD; it can then only be moved here (default off)
HUD_CLICK_THROUGH=off
# compact | expanded (expanded adds the 8 strips with names and meters)
HUD_LAYOUT=compact
# How long an action toast stays visible, in ms (default 1200)
HUD_TOAST_MS=1200
# Read Cakewalk's MCU LCD text (track names, values, messages): on | off (default on)
HUD_LCD=on
