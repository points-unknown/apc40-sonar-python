# **************************** #
# ******   BASIC SETUP  ****** #
# **************************** #
# APC40 <-> Cakewalk port names (edit these, then re-run:
#   uv run apc40sonar --list-ports
# Windows/loopMIDI renames cables between iterations, so match what the
# listing shows. No reboot or code change is required.
#
# APC40_PORT        physical controller        (read + write)
# MCU_OUT_PORT      app -> Cakewalk surface    (write)
# MCU_IN_PORT       Cakewalk surface -> app    (read)
# APC40_CLIENT_NAME name this app shows to WinMM

APC40_PORT=Akai APC40
MCU_OUT_PORT=APC40-IN
MCU_IN_PORT=APC40-OUT
APC40_CLIENT_NAME=apc40sonar
# APC40 operating mode: generic | ableton | alt-ableton
APC40_MODE=generic


# ************************************ #
# ******   FEATURE FINE TUNING  ****** #
# ************************************ #
# Max V-pot steps per Track/Device knob event; lower = finer control (default 3)
KNOB_STEP_LIMIT=3
# Ignore knob steps larger than this as noise/ring re-reference (default 4; 0 = off)
KNOB_NOISE_THRESHOLD=4
# Track level meters on the clip grid, clip latch on Clip Stop: on | off (default on)
METERS=on
# Meter fall time per grid segment in milliseconds (default 300, like a real MCU)
METER_DECAY_MS=300
# Crossfader zoom: slider travel (0-127 scale) per zoom step; lower = faster (default 6)
ZOOM_STEP_UNITS=6
# Leave Cakewalk's zoom mode this long after the crossfader stops, in ms (default 300)
ZOOM_IDLE_MS=300


# ****************************** #
# ******   ON-SCREEN HUD  ****** #
# ****************************** #
# Small always-on-top window: knob mode, transport, track names, toasts (default on)
HUD=on
# UDP port on 127.0.0.1 between the app and the HUD window (default 47040)
HUD_PORT=47040
# top-left | top-right | bottom-left | bottom-right | x,y  (default top-right)
HUD_POSITION=top-right
# Monitor index for placement, 0 = primary (default 0)
HUD_MONITOR=0
# Window opacity 0.2-1.0 (default 0.85)
HUD_OPACITY=0.85
# Keep the HUD above other windows: on | off (default on)
HUD_TOPMOST=on
# Mouse clicks pass through the HUD; it can then only be moved here (default off)
HUD_CLICK_THROUGH=off
# compact | expanded (expanded adds the 8 strips with names and meters)
HUD_LAYOUT=compact
# How long an action toast stays visible, in ms (default 1200)
HUD_TOAST_MS=1200
# Read Cakewalk's MCU LCD text (track names, values, messages): on | off (default on)
HUD_LCD=on
